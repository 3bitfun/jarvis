<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>1.3.1</Version>
    <ApplicationIcon>Assets\Jarvis.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\**\*" />
    <AvaloniaResource Include="Assets\Jarvis.ico" />
    <AvaloniaResource Include="Assets\Jarvis.png" />
    <AvaloniaResource Include="Assets\Icons\icons.json" />
    <Content Include="Assets\Fonts\**\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Refresh native assets even when changing to an older compatible package. -->
    <Content Update="$(NuGetPackageRoot)llamasharp.backend.cpu\0.27.0\LLamaSharpRuntimes\**\*"
             CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="models\*.gguf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(IncludeLocalModels)' != 'false'" />
  </ItemGroup>
</Project>
