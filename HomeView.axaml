<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:JARVIS" x:Class="JARVIS.HomeView">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="26" Margin="30" MaxWidth="960">
   <Border x:Name="CommandStatus" IsVisible="False" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource RaisedBrush}" Padding="16,12"><Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="14"><StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="J.A.R.V.I.S.  /  COMMAND CENTER" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="CommandEngine" Classes="muted" FontSize="11" Text="Engine status"/></StackPanel><local:AssistantMark x:Name="CommandCore" Grid.Column="1" Width="96" Height="96"/><TextBlock Grid.Column="2" Text="SYSTEM ONLINE" Foreground="{DynamicResource AccentBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border>
   <StackPanel x:Name="HomeHero" Spacing="12" Margin="0,18,0,0">
    <TextBlock Classes="label" Text="Your personal space" Foreground="{DynamicResource AccentBrush}"/>
    <TextBlock x:Name="Greeting" Text="Welcome home." FontSize="36" FontWeight="Normal"/>
    <TextBlock Text="Chat, launch apps, and manage your workspace." Classes="muted" FontSize="15" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,8,0,0"><Button Classes="primary" AutomationProperties.Name="Start a conversation" Click="NewChat_Click" Margin="0,0,10,10"><StackPanel Orientation="Horizontal" Spacing="8"><local:AppIcon Kind="plus"/><TextBlock Text="Start a conversation" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Quick launcher" Click="QuickBar_Click" ToolTip.Tip="Alt+Space" Margin="0,0,10,10"><StackPanel Orientation="Horizontal" Spacing="8"><local:AppIcon Kind="search"/><TextBlock Text="Quick launcher" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Work focus" Click="Routine_Click" Margin="0,0,10,10"><StackPanel Orientation="Horizontal" Spacing="8"><local:AppIcon Kind="clock"/><TextBlock Text="Work focus" VerticalAlignment="Center"/></StackPanel></Button></WrapPanel>
   </StackPanel>
   <Border x:Name="SetupCard" Classes="homeCard" BorderBrush="{DynamicResource AccentBrush}"><StackPanel Spacing="12"><TextBlock Text="Start with an engine." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="1  Choose a cloud provider and paste your API key, or import a local GGUF.&#10;2  Fetch a model or enter its slug, then save your settings.&#10;3  Start a conversation. Add personal context whenever you're ready." Classes="muted" LineHeight="25"/><Button AutomationProperties.Name="Set up J.A.R.V.I.S." Classes="primary" Click="Engine_Click" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><local:AppIcon Kind="bolt"/><TextBlock Text="Set up J.A.R.V.I.S." VerticalAlignment="Center"/></StackPanel></Button></StackPanel></Border>
   <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12"><StackPanel Spacing="6"><TextBlock Text="YOUR WORKSPACE" Classes="label"/><TextBlock x:Name="LibrarySummary" Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
   <StackPanel Spacing="12"><TextBlock Text="A starting point" Classes="label"/><WrapPanel><Button AutomationProperties.Name="Write something" Tag="Help me write something clear and useful. Ask what I am writing and who it is for." Click="Starter_Click" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="8"><local:AppIcon Kind="pen"/><TextBlock Text="Write something" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Plan my day" Tag="Help me plan a realistic day. Ask me for my priorities, fixed commitments, and available time." Click="Starter_Click" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="8"><local:AppIcon Kind="calendar"/><TextBlock Text="Plan my day" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Explain a topic" Tag="Help me understand a topic with a simple explanation and examples. Ask what I want to learn." Click="Starter_Click" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="8"><local:AppIcon Kind="book"/><TextBlock Text="Explain a topic" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Review my code" Tag="Help me review code for correctness and readability. Ask me to attach the relevant code and explain the expected behavior." Click="Starter_Click" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="8"><local:AppIcon Kind="code"/><TextBlock Text="Review my code" VerticalAlignment="Center"/></StackPanel></Button></WrapPanel></StackPanel>
   <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
    <Border Classes="homeCard"><StackPanel Spacing="8"><TextBlock Text="Intelligence" Classes="label"/><TextBlock x:Name="EngineText" Text="Local engine" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="EngineStatus" Classes="muted" Text="Choose an engine to get started." TextWrapping="Wrap" FontSize="12"/><Button Classes="quiet" AutomationProperties.Name="Manage engine" Click="Engine_Click" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><local:AppIcon Kind="brain"/><TextBlock Text="Manage engine" VerticalAlignment="Center"/></StackPanel></Button></StackPanel></Border>
    <Border Grid.Column="1" Classes="homeCard"><StackPanel Spacing="8"><TextBlock Text="Knowledge" Classes="label"/><TextBlock x:Name="KnowledgeText" Text="Your reference library" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Bring your notes and projects into the conversation." Classes="muted" FontSize="12" TextWrapping="Wrap"/><Button Classes="quiet" AutomationProperties.Name="Add knowledge" Click="Knowledge_Click" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><local:AppIcon Kind="book"/><TextBlock Text="Add knowledge" VerticalAlignment="Center"/></StackPanel></Button></StackPanel></Border>
   </Grid>
   <Border Classes="homeCard"><StackPanel Spacing="8"><TextBlock Text="Work focus" Classes="label"/><TextBlock x:Name="RoutineStatus" Text="Choose up to three apps in Settings → Apps, then start a focused work session." Classes="muted" TextWrapping="Wrap"/><Button Classes="quiet" AutomationProperties.Name="Set up work apps" Click="RoutineSettings_Click" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><local:AppIcon Kind="terminal"/><TextBlock Text="Set up work apps" VerticalAlignment="Center"/></StackPanel></Button></StackPanel></Border>
   <StackPanel Spacing="12"><TextBlock Classes="label" Text="Continue a conversation"/><StackPanel x:Name="RecentChats" Spacing="8"/></StackPanel>
   <TextBlock Classes="muted" FontSize="11" Text="Alt+Space  quick chat and apps     ·     Alt+J  show or hide the full deck" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
