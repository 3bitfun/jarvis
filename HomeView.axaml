<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="JARVIS.HomeView">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="26" Margin="30" MaxWidth="960">
   <StackPanel Spacing="12" Margin="0,18,0,0">
    <TextBlock Classes="label" Text="Your personal space" Foreground="{DynamicResource AccentBrush}"/>
    <TextBlock x:Name="Greeting" Text="Welcome home." FontSize="36" FontWeight="Normal"/>
    <TextBlock Text="A place for your ideas, your questions, and whatever comes next." Classes="muted" FontSize="15" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0"><Button Classes="primary" Content="＋  Start a conversation" Click="NewChat_Click"/><Button Content="Quick launcher  ↗" Click="QuickBar_Click" ToolTip.Tip="Alt+Space"/><Button Content="Work focus  ▶" Click="Routine_Click"/></StackPanel>
   </StackPanel>
   <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
    <Border Classes="homeCard"><StackPanel Spacing="8"><TextBlock Text="Intelligence" Classes="label"/><TextBlock x:Name="EngineText" Text="Local engine" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="EngineStatus" Classes="muted" Text="Choose an engine to get started." TextWrapping="Wrap" FontSize="12"/><Button Classes="quiet" Content="Manage engine →" Click="Engine_Click" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Grid.Column="1" Classes="homeCard"><StackPanel Spacing="8"><TextBlock Text="Knowledge" Classes="label"/><TextBlock x:Name="KnowledgeText" Text="Your reference library" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Bring your notes and projects into the conversation." Classes="muted" FontSize="12" TextWrapping="Wrap"/><Button Classes="quiet" Content="Add knowledge →" Click="Knowledge_Click" HorizontalAlignment="Left"/></StackPanel></Border>
   </Grid>
   <Border Classes="homeCard"><StackPanel Spacing="8"><TextBlock Text="Work focus" Classes="label"/><TextBlock x:Name="RoutineStatus" Text="Choose up to three apps in Settings → Apps, then start a focused work session." Classes="muted" TextWrapping="Wrap"/><Button Classes="quiet" Content="Set up work apps →" Click="RoutineSettings_Click" HorizontalAlignment="Left"/></StackPanel></Border>
   <StackPanel Spacing="12"><TextBlock Classes="label" Text="Continue a conversation"/><StackPanel x:Name="RecentChats" Spacing="8"/></StackPanel>
   <Border Classes="homeCard"><StackPanel Spacing="12"><TextBlock Text="Make J.A.R.V.I.S. yours" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Add a few details about yourself, choose your preferred engine, and find a theme that feels right." Classes="muted" TextWrapping="Wrap"/><WrapPanel><Button Classes="quiet" Content="About you  →" Click="Knowledge_Click" Margin="0,0,12,8"/><Button Classes="quiet" Content="Appearance  →" Click="Style_Click" Margin="0,0,12,8"/></WrapPanel></StackPanel></Border>
   <TextBlock Classes="muted" FontSize="11" Text="Alt+Space  quick chat and apps     ·     Alt+J  show or hide the full deck" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
